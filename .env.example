# REQUIRED — paste the normal browser URL of the Google Sheet tab that holds the data.
# The sheet must be shared as "Anyone with the link → Viewer".
# The #gid=... part of the URL picks the tab, so open the right tab before copying the URL.
SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit#gid=0

# OPTIONAL — pick the tab by name instead of by gid.
# SHEET_NAME=Raw Data

# OPTIONAL — currency fallback. The dashboard first looks for a "currency" column in the sheet,
# or a code in a header like "Cost (AUD)". If neither exists, this is used. Default: AUD.
# CURRENCY=AUD

# OPTIONAL — number/date formatting locale. Default is picked from the currency (AUD → en-AU).
# LOCALE=en-AU

# OPTIONAL — only needed if the sheet uses ambiguous slash dates like 04/09/2026. DMY or MDY.
# DATE_ORDER=DMY

# OPTIONAL — heading shown at the top of the dashboard.
# DASHBOARD_TITLE=Google Ads Performance
